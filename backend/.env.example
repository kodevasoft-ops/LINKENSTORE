# ── Django ─────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-min-50-chars-truly-random-string-here-12345
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
SITE_NAME=Katalog Enterprise

# ── Database ───────────────────────────────────────────────────────────────
DB_NAME=katalog
DB_USER=katalog_user
DB_PASSWORD=super-strong-password-here
DB_HOST=pgbouncer
DB_PORT=5432
DB_SSLMODE=require
DB_REPLICA_HOST=        # Optional: read replica host for analytics

# ── Redis ──────────────────────────────────────────────────────────────────
# En producción usa rediss:// (TLS) — ej: rediss://:tu-password@host:6380/0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Wompi (pasarela de pagos) ────────────────────────────────────────────
WOMPI_PUBLIC_KEY=pub_prod_xxx
WOMPI_PRIVATE_KEY=prv_prod_xxx
WOMPI_EVENTS_SECRET=xxx
WOMPI_INTEGRITY_SECRET=xxx
WOMPI_API_URL=https://production.wompi.co/v1

# ── TNS ERP ────────────────────────────────────────────────────────────────
TNS_API_URL=https://erp.yourtns.com/api
TNS_API_KEY=your-tns-api-key
TNS_HMAC_SECRET=your-tns-hmac-secret-min-32-chars

# ── InterSoft API (rastreo de guías Interrápidísimo) ───────────────────────
INTERSOFT_BASE_URL=https://su-dominio.kodevasoft.space
INTERSOFT_API_KEY=isk_live_xxx
INTERSOFT_SECRET_KEY=ssk_xxx

# ── Google Sign-In (login social de clientes) ──────────────────────────────
# Crear en https://console.cloud.google.com/apis/credentials — tipo "OAuth client ID / Web application"
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# ── Cifrado de credenciales en BD ───────────────────────────────────────────
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── Email ──────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASSWORD=your-resend-api-key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Cloudflare R2 (media files — reemplaza AWS S3) ─────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=katalog-media-prod
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_PUBLIC_DOMAIN=media.yourdomain.com   # dominio público custom conectado al bucket R2

# ── Sentry (error tracking) ────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx

# ── Monitoring ─────────────────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=change-this-password

# ── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXTAUTH_SECRET=change-me-random-32-chars-min
NEXTAUTH_URL=https://yourdomain.com

# ── SSL ────────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
