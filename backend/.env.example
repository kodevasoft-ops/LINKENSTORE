# ── Django ─────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-min-50-chars-truly-random-string-here-12345
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
SITE_NAME=Katalog Enterprise

# ── Database ───────────────────────────────────────────────────────────────
DB_NAME=katalog
DB_USER=katalog_user
DB_PASSWORD=super-strong-password-here
DB_HOST=pgbouncer
DB_PORT=5432
DB_REPLICA_HOST=        # Optional: read replica host for analytics

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── TNS ERP ────────────────────────────────────────────────────────────────
TNS_API_URL=https://erp.yourtns.com/api
TNS_API_KEY=your-tns-api-key
TNS_HMAC_SECRET=your-tns-hmac-secret-min-32-chars

# ── Email ──────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASSWORD=your-resend-api-key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── AWS S3 (media files — required for horizontal scaling) ─────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET=katalog-media-prod
AWS_S3_REGION=us-east-1
AWS_CLOUDFRONT_DOMAIN=   # Optional CDN domain

# ── Sentry (error tracking) ────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx

# ── Monitoring ─────────────────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=change-this-password

# ── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXTAUTH_SECRET=change-me-random-32-chars-min
NEXTAUTH_URL=https://yourdomain.com

# ── SSL ────────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
